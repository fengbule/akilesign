# Domain with DNS pointing to the VPS, or http://YOUR_SERVER_IP for a temporary HTTP test.
DOMAIN=checkin.example.com

# At least 12 characters. This protects the external management UI.
ADMIN_PASSWORD=replace-with-a-long-password

# Generate each value independently with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-random-hex-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-random-hex-characters

CHECKIN_TIME=09:10
TZ=Asia/Shanghai
SESSION_HOURS=24
SECURE_COOKIE=true
PORT=3000
DATA_DIR=/app/data
